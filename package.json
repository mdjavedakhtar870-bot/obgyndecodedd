{
  "name": "obgyn-decoded",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OBGYN Decoded - doctor-facing obstetrics & gynaecology clinical reference and decision-support application (India-first). Static Netlify-deployable PWA.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node --import tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/content.test.ts tests/seo.test.ts tests/crawler.test.ts",
    "test:build": "node --import tsx --test tests/build.test.ts",
    "test:client": "node --import tsx --test tests/client.test.ts",
    "docs:matrix": "node --import tsx scripts/gen-source-matrix.mts"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@netlify/edge-functions": "^4.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.0",
    "turndown": "^7.2.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
