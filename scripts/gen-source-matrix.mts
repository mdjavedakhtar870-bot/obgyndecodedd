/* Generate documentation from the same assembled library used by the app.
   Generation records authored status; it never performs or invents an audit. */
import fs from 'node:fs'
import { ALL_TOPICS, DRUGS, CALCULATORS, EMERGENCIES, PROCEDURES, SOURCES, SOURCE_MAP_META } from '../src/content/index'

const date = new Date().toISOString().slice(0, 10)
const write = (file: string, text: string) => fs.writeFileSync(file, `${text.trimEnd()}\n`)
const cell = (value: unknown) => String(value ?? '—').replaceAll('|', '\\|').replaceAll('\n', ' ')
const table = (headers: string[], rows: unknown[][]) => `| ${headers.join(' | ')} |\n| ${headers.map(() => '---').join(' | ')} |\n${rows.map((row) => `| ${row.map(cell).join(' | ')} |`).join('\n')}\n`
const recorded = ALL_TOPICS.filter((t) => t.lastVerifiedAt && ['published', 'clinically-verified'].includes(t.status))
const pending = ALL_TOPICS.filter((t) => !recorded.includes(t))
const detailed = ALL_TOPICS.filter((t) => t.clinicalDetail)
const intro = `Generated ${date} from the assembled application library. Do not hand-edit this file. Documentation generation does not verify clinical recommendations.\n\n`
fs.mkdirSync('docs', { recursive: true })

write('docs/CLINICAL-SOURCE-MATRIX.md', `# Clinical Source Matrix — OBGYN Decoded\n\n${intro}Last recorded full registry review: ${SOURCE_MAP_META.lastRegistryReview}. Additional scoped content update: ${SOURCE_MAP_META.lastScopedContentUpdate}. These are different scopes.\n\n${table(['Source ID', 'Organisation', 'Document', 'Version', 'Date checked', 'Status', 'Used by'], SOURCES.map((s) => [s.id, s.organisation, `[${s.title}](${s.url})`, s.version, s.dateChecked, s.status, s.usedBySections.join(', ')]))}\n## Recorded source-check scope\n\n${SOURCES.map((s) => `- **${s.id}**: ${s.checkedAgainst || 'No recommendation-level check scope recorded.'}`).join('\n')}\n`)

write('docs/CLINICAL-AUDIT.md', `# Clinical Audit Register — OBGYN Decoded\n\n${intro}The dates below are authored records, not a claim that this documentation run repeated the clinical audit. A dated additional-detail section does not certify the rest of its module.\n\n## Modules with a recorded clinical-verification date\n\n${table(['Module', 'Authored status', 'Version', 'Recorded verification date', 'Sources'], recorded.map((t) => [t.id, t.status, t.version, t.lastVerifiedAt, t.sourceIds.join(', ')]))}\n## Modules pending review or without a qualifying verification record\n\n${table(['Module', 'Authored status', 'Version', 'Sources'], pending.map((t) => [t.id, t.status, t.version, t.sourceIds.join(', ')]))}\n## Additional clinical-detail checks — limited scope\n\n${table(['Module', 'Section check date', 'Sources'], detailed.map((t) => [t.id, t.clinicalDetail!.checkedAt, t.clinicalDetail!.sourceIds.join(', ')]))}\n`)

write('docs/FINAL-CLINICAL-REVIEW.md', `# Clinical Review Status — OBGYN Decoded\n\n${intro}## Library coverage\n\n- Clinical topics: ${ALL_TOPICS.length}.\n- Topics with an authored clinical-verification record: ${recorded.length}. This run did not reverify those entire modules.\n- Topics in review, outdated, or without a qualifying full-module verification record: ${pending.length}.\n- Additional clinical-detail sections checked with explicit scope: ${detailed.length}.\n- Registered sources: ${SOURCES.length}.\n- Drug references: ${DRUGS.length}; calculators: ${CALCULATORS.length}; emergency protocols: ${EMERGENCIES.length}; procedures: ${PROCEDURES.length}.\n\n## Current changes\n\nThe 17 October 2026 content work adds assessment, decision, follow-up and pitfall explanations to 42 topics, with section-specific sources and dates. Identified early-pregnancy errors and unrelated reference mappings were corrected; the affected modules remain in review. Methotrexate and miscarriage drug rows and dependent emergency/procedure references were checked for consistency with those changes. This is not a full-library word-by-word audit.\n\n## Outstanding scope\n\n- The module statuses and dates in CLINICAL-AUDIT.md remain the source of truth. Additional source checks do not promote a module to clinically verified.\n- Broad viral-infection and chronic-medical-disorder indexes remain concise references requiring specialist expansion and source checking.\n- Remaining legacy regimens, rare-site ectopic treatment, legal details and oncology protocols have not all been independently reverified by this update.\n- The NHS GGC methotrexate source records a scheduled review date of September 2026. Its dose/follow-up reference is labelled as a limited check; confirm the current institutional protocol.\n- UK, U.S. and international guidance is labelled; local application in India requires the appropriate clinical context.\n\n## Validation and publishing\n\nRun type checking, content/security tests, documentation generation, the production build, build checks and client checks. Mobile browser checks cover generated-page widths and the navigation/reading controls. These engineering checks do not establish clinical correctness. Ask the owner before updating production.\n`)
console.log(`Docs generated from application data: ${SOURCES.length} sources; ${ALL_TOPICS.length} topics (${recorded.length} recorded verification dates; ${detailed.length} scoped detail checks).`)
